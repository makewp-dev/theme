{
  "name": "makewp/theme",
  "description": "Make WordPress themes, better.",
  "type": "library",
  "version": "0.1.2",
  "license": "MIT",
  "keywords": [
    "wordpress",
    "wordpress-theme"
  ],
  "homepage": "https://makewp-dev.github.io/theme",
  "support": {
    "issues": "https://github.com/makewp-dev/theme/issues",
    "source": "https://github.com/makewp-dev/theme"
  },
  "autoload": {
    "psr-4": {
      "MakeWP\\Theme\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "authors": [
    {
      "name": "Taylor Gorman",
      "email": "taylor@thegorman.group"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
